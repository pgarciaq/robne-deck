{
  "name": "robne-deck",
  "version": "1.0.0",
  "private": true,
  "description": "Marp presentation: ROS-OCP Native Engine",
  "scripts": {
    "serve": "marp --no-stdin -s .",
    "build:html": "marp --no-stdin slides.md -o dist/slides.html",
    "build:pdf": "marp --no-stdin slides.md -o dist/slides.pdf --allow-local-files"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.1.2"
  }
}
